[Unit]
Description=Play USB sound
After=alsa-restore.service

[Service]
User={user}
Type=oneshot
Environment="XDG_RUNTIME_DIR=/run/user/1000"
ExecStart=-/usr/bin/pw-play --target alsa_output.pci-0000_00_1f.3.analog-stereo /etc/sounds/USB-Insert.wav
Environment=DISPLAY=:0 XAUTHORITY=/home/{user}/.Xauthority
TimeoutStartSec=5

[Install]
WantedBy=sound.target
